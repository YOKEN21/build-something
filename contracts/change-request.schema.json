{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Change request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue",
    "change_type",
    "summary",
    "product",
    "service",
    "environment",
    "allowed_paths",
    "plan_revision",
    "acceptance_expectation"
  ],
  "properties": {
    "issue": { "type": "integer", "minimum": 1 },
    "change_type": {
      "type": "string",
      "enum": ["new-service", "config-change", "iam-permission-change"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "product": { "type": "string", "minLength": 1 },
    "service": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "enum": ["dev", "prod"] },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "acceptance_expectation": { "type": "string", "minLength": 1 }
  }
}
